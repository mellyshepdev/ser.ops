# ser.ops mail rules — first match wins, anything unmatched is kept.
#
#   from:<glob>|trash        match against the From: header only
#   subject:<glob>|trash     match against the Subject: header only
#   <glob>|trash             match against "From Subject" together
#
# The glob is a shell pattern wrapped in *...*, so a plain substring works as
# written and * / ? / [abc] behave as wildcards. Matching is case-SENSITIVE,
# so add both spellings where a sender varies.
#
# "trash" is not a delete. The message is archived to unit3 first, always,
# then copied to the account's trash folder and expunged from the inbox —
# recoverable from the provider's trash for ~30 days.
#
# Nothing is enabled by default. Uncomment or add lines deliberately: a bad
# glob here quietly bins real mail, and the only copy is then the unit3 mbox.

# ── Obvious bulk senders ──────────────────────────────────────────────
# from:@linkedin.com|trash
# from:@e.linkedin.com|trash
# from:noreply@|trash
# from:no-reply@|trash
# from:donotreply@|trash

# ── Marketing / newsletters ───────────────────────────────────────────
# subject:Unsubscribe|trash
# subject:% off|trash
# subject:Flash Sale|trash

# ── Always keep, even if a rule below would bin it ────────────────────
# Put keeps FIRST — first match wins, so these must precede the trash rules
# to have any effect.
from:@theofficialblacksheepco.com|keep
from:@puff-base.com|keep
subject:invoice|keep
subject:Invoice|keep
subject:order|keep
subject:Order|keep
